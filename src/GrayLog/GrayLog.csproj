<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>GrayLog</RootNamespace>
    <UseWPF>true</UseWPF>
    <AssemblyName>GrayLog</AssemblyName>
    <!-- Semantic Versioning. Keep in sync with source.extension.vsixmanifest (the build fails on mismatch) and CHANGELOG.md. -->
    <Version>2.1.0</Version>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GrayLog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="GrayLogPackage.vsct" ResourceName="Menus.ctmenu" />
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="..\..\LICENSE" Link="LICENSE" IncludeInVSIX="true" />
  </ItemGroup>

  <Target Name="CheckManifestVersion" BeforeTargets="Build">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/x:PackageManifest/x:Metadata/x:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="ManifestVersion" />
    </XmlPeek>
    <Error Condition="'$(ManifestVersion)' != '$(Version)'"
           Text="Version mismatch: GrayLog.csproj has $(Version), source.extension.vsixmanifest has $(ManifestVersion)." />
  </Target>

  <!-- Release builds copy the installable package to <repo>/publish/GrayLog-<version>.vsix. -->
  <Target Name="CopyVsixToPublish" AfterTargets="CreateVsixContainer" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetVsixContainer)" DestinationFiles="$(MSBuildThisFileDirectory)..\..\publish\GrayLog-$(Version).vsix" />
  </Target>

</Project>
